# Copy this file to .env at the repository root, then fill in the two GitHub OAuth values.
# The API reads .env at startup. Existing terminal variables take precedence.
# Restart the API after editing. Never commit .env or put secrets in VITE_* variables.

# GitHub OAuth App credentials (Settings > Developer settings > OAuth Apps).
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3001/api/auth/github/callback
FACTORY_GITHUB_CLIENT_ID=
FACTORY_GITHUB_CLIENT_SECRET=

# Configure the first administrator separately with:
# pnpm factory admin setup --provider github --username YOUR_GITHUB_USERNAME

# Local API defaults. Keep localhost consistent for browser origins and cookies.
FACTORY_API_BIND=127.0.0.1:3001
FACTORY_WEB_ORIGIN=http://localhost:3000
FACTORY_API_ORIGIN=http://localhost:3001

# Prepare the shared local environment image explicitly:
# pnpm environments:prepare
# Restart the API after preparation. Environments keep running after sign-out.
