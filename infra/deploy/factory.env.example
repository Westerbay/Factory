# Copy to the installation's .env on the VPS and set mode 0600.
# Public HTTPS URL for both the bundled web app and the API.
FACTORY_WEB_ORIGIN=https://factory.example.com
# Set a sibling HTTPS origin only when hosting the web app separately.
# FACTORY_API_ORIGIN=https://factory-api.example.com
FACTORY_GITHUB_CLIENT_ID=
FACTORY_GITHUB_CLIENT_SECRET=
# Generate two different random passwords. Hex strings work without Compose escaping.
FACTORY_POSTGRES_PASSWORD=
FACTORY_DB_PASSWORD=
