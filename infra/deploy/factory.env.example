# Copy to the installation's .env on the VPS and set mode 0600.
# Use the domain you own, without a scheme or subdomain prefix.
FACTORY_DOMAIN=example.com
FACTORY_GITHUB_CLIENT_ID=
FACTORY_GITHUB_CLIENT_SECRET=
# Generate two different random passwords. Hex strings work without Compose escaping.
FACTORY_POSTGRES_PASSWORD=
FACTORY_DB_PASSWORD=
