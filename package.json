{
  "name": "factory",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @workspace/desktop dev",
    "start": "pnpm --filter @workspace/desktop start",
    "build": "turbo build",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries:check": "depcruise --config packages/config/dependency-cruiser.mjs apps packages",
    "boundaries:test": "node --test scripts/test/boundaries.test.mjs",
    "test": "pnpm boundaries:test",
    "docs:check": "node scripts/docs-check.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm boundaries:check && pnpm docs:check && pnpm build"
  },
  "devDependencies": {
    "dependency-cruiser": "18.6.0",
    "prettier": "3.8.3",
    "turbo": "2.9.18",
    "typescript": "5.9.3",
    "eslint": "9.36.0",
    "@eslint/js": "9.36.0",
    "typescript-eslint": "8.72.0",
    "globals": "16.4.0",
    "@types/node": "24.5.2"
  }
}
