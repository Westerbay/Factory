{
  "name": "factory",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @workspace/desktop dev",
    "start": "pnpm --filter @workspace/desktop start",
    "build": "turbo build",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries:check": "depcruise --config packages/config/dependency-cruiser.mjs apps packages",
    "boundaries:test": "node --test scripts/test/boundaries.test.mjs",
    "test": "pnpm execution:test && pnpm adapters:test && pnpm database:test && pnpm boundaries:test",
    "docs:check": "node scripts/docs-check.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm boundaries:check && pnpm docs:check && pnpm build",
    "execution:test": "pnpm --filter @workspace/application... build && pnpm --filter @workspace/contracts build && tsc --project packages/contracts/test/tsconfig.json && node --test packages/application/test/*.test.mjs packages/contracts/test/*.test.mjs",
    "db:build": "pnpm --filter @workspace/database... build",
    "db:setup": "pnpm db:build && node scripts/database/local.mjs setup",
    "db:migrate": "pnpm db:build && node scripts/database/local.mjs migrate",
    "db:status": "pnpm db:build && node scripts/database/local.mjs status",
    "db:stop": "pnpm db:build && node scripts/database/local.mjs stop",
    "database:test": "pnpm db:build && node --test packages/database/test/target.test.mjs",
    "test:integration": "pnpm --filter @workspace/database... --filter @workspace/application... build && node scripts/database/integration.mjs",
    "adapters:test": "pnpm --filter @workspace/adapters... --filter @workspace/application... build && node --test packages/adapters/test/*.test.mjs",
    "codex:protocol": "node packages/adapters/scripts/generate-protocol.mjs",
    "codex:probe": "pnpm --filter @workspace/adapters... build && node packages/adapters/scripts/probe.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "18.6.0",
    "prettier": "3.8.3",
    "turbo": "2.9.18",
    "typescript": "5.9.3",
    "eslint": "9.36.0",
    "@eslint/js": "9.36.0",
    "typescript-eslint": "8.72.0",
    "globals": "16.4.0",
    "@types/node": "24.5.2"
  }
}
