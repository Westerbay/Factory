{
  "components": {
    "schemas": {
      "AccessAction": {
        "enum": ["active", "suspended"],
        "type": "string"
      },
      "AccessBody": {
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/AccessAction"
          }
        },
        "required": ["status", "expectedVersion"],
        "type": "object"
      },
      "AdminUser": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          },
          "version": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "displayName",
          "handle",
          "provider",
          "role",
          "status",
          "version"
        ],
        "type": "object"
      },
      "ApiError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["code", "message", "requestId"],
        "type": "object"
      },
      "EnvironmentResponse": {
        "properties": {
          "errorCode": {
            "description": "Bounded public error code; never includes provider responses or resource names.",
            "type": ["string", "null"]
          },
          "idleExpiresAt": {
            "format": "date-time",
            "type": ["string", "null"]
          },
          "observedAt": {
            "format": "date-time",
            "type": ["string", "null"]
          },
          "status": {
            "$ref": "#/components/schemas/EnvironmentStatus"
          }
        },
        "required": ["status"],
        "type": "object"
      },
      "EnvironmentStatus": {
        "enum": [
          "not_created",
          "starting",
          "running",
          "stopping",
          "stopped",
          "error",
          "unavailable"
        ],
        "type": "string"
      },
      "Live": {
        "properties": {
          "status": {
            "enum": ["ok"],
            "type": "string"
          }
        },
        "required": ["status"],
        "type": "object"
      },
      "Ready": {
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": ["status", "code"],
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "csrfToken": {
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        },
        "required": ["user", "expiresAt", "csrfToken"],
        "type": "object"
      },
      "SessionUser": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "required": ["id", "displayName", "handle", "role"],
        "type": "object"
      },
      "UserRole": {
        "enum": ["member", "admin"],
        "type": "string"
      },
      "UserStatus": {
        "enum": ["pending", "active", "suspended"],
        "type": "string"
      },
      "UsersResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminUser"
            },
            "type": "array"
          },
          "nextCursor": {
            "format": "uuid",
            "type": ["string", "null"]
          }
        },
        "required": ["items"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "in": "cookie",
        "name": "factory_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Local private identity API. Generated without runtime configuration.",
    "title": "Factory API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/users": {
      "get": {
        "operationId": "listUsers",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UserStatus"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersResponse"
                }
              }
            },
            "description": "Users in stable UUID order"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid input"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Session required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Access denied"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "User not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Conflict or protected administrator"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Rate limit"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Dependency unavailable"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
