{
  "components": {
    "schemas": {
      "AccessAction": {
        "enum": ["active", "suspended"],
        "type": "string"
      },
      "AccessBody": {
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/AccessAction"
          }
        },
        "required": ["status", "expectedVersion"],
        "type": "object"
      },
      "AdminUser": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          },
          "version": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "displayName",
          "handle",
          "provider",
          "role",
          "status",
          "version"
        ],
        "type": "object"
      },
      "AgentAccount": {
        "properties": {
          "email": {
            "type": ["string", "null"]
          },
          "plan": {
            "type": "string"
          }
        },
        "required": ["plan"],
        "type": "object"
      },
      "AgentConnectionResponse": {
        "properties": {
          "account": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AgentAccount"
              },
              {
                "type": "null"
              }
            ]
          },
          "challenge": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AgentLoginChallenge"
              },
              {
                "type": "null"
              }
            ]
          },
          "errorCode": {
            "description": "Bounded application error code, never the raw provider response.",
            "type": ["string", "null"]
          },
          "observedAt": {
            "format": "date-time",
            "type": ["string", "null"]
          },
          "provider": {
            "$ref": "#/components/schemas/AgentProvider"
          },
          "status": {
            "$ref": "#/components/schemas/AgentConnectionStatus"
          }
        },
        "required": ["provider", "status"],
        "type": "object"
      },
      "AgentConnectionStatus": {
        "enum": [
          "unavailable",
          "disconnected",
          "connecting",
          "connected",
          "error"
        ],
        "type": "string"
      },
      "AgentLoginChallenge": {
        "description": "Device authorization instructions, never provider credentials or a provider login ID.",
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "operationId": {
            "format": "uuid",
            "type": "string"
          },
          "userCode": {
            "type": "string"
          },
          "verificationUrl": {
            "type": "string"
          }
        },
        "required": ["operationId", "verificationUrl", "userCode", "expiresAt"],
        "type": "object"
      },
      "AgentProvider": {
        "enum": ["codex"],
        "type": "string"
      },
      "ApiError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["code", "message", "requestId"],
        "type": "object"
      },
      "AttachmentRequest": {
        "additionalProperties": false,
        "properties": {
          "takeOver": {
            "type": "boolean"
          }
        },
        "required": ["takeOver"],
        "type": "object"
      },
      "AttachmentResponse": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "ticket": {
            "type": "string"
          }
        },
        "required": ["ticket", "expiresAt"],
        "type": "object"
      },
      "CancelAgentLoginBody": {
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["operationId"],
        "type": "object"
      },
      "EnvironmentResponse": {
        "properties": {
          "errorCode": {
            "description": "Bounded public error code; never includes provider responses or resource names.",
            "type": ["string", "null"]
          },
          "observedAt": {
            "format": "date-time",
            "type": ["string", "null"]
          },
          "status": {
            "$ref": "#/components/schemas/EnvironmentStatus"
          }
        },
        "required": ["status"],
        "type": "object"
      },
      "EnvironmentStatus": {
        "enum": [
          "not_created",
          "starting",
          "running",
          "stopping",
          "stopped",
          "error",
          "unavailable"
        ],
        "type": "string"
      },
      "Live": {
        "properties": {
          "status": {
            "enum": ["ok"],
            "type": "string"
          }
        },
        "required": ["status"],
        "type": "object"
      },
      "Ready": {
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": ["status", "code"],
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "csrfToken": {
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        },
        "required": ["user", "expiresAt", "csrfToken"],
        "type": "object"
      },
      "SessionUser": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "required": ["id", "displayName", "handle", "role"],
        "type": "object"
      },
      "TerminalClientMessage": {
        "description": "UTF-8 JSON inputs for factory.terminal.v1. Output data uses binary frames.",
        "oneOf": [
          {
            "properties": {
              "ticket": {
                "type": "string"
              },
              "type": {
                "enum": ["authenticate"],
                "type": "string"
              }
            },
            "required": ["ticket", "type"],
            "type": "object"
          },
          {
            "properties": {
              "data": {
                "type": "string"
              },
              "type": {
                "enum": ["input"],
                "type": "string"
              }
            },
            "required": ["data", "type"],
            "type": "object"
          },
          {
            "properties": {
              "cols": {
                "format": "int32",
                "minimum": 0,
                "type": "integer"
              },
              "rows": {
                "format": "int32",
                "minimum": 0,
                "type": "integer"
              },
              "type": {
                "enum": ["resize"],
                "type": "string"
              }
            },
            "required": ["cols", "rows", "type"],
            "type": "object"
          },
          {
            "properties": {
              "bytes": {
                "format": "int32",
                "minimum": 0,
                "type": "integer"
              },
              "type": {
                "enum": ["ack"],
                "type": "string"
              }
            },
            "required": ["bytes", "type"],
            "type": "object"
          }
        ]
      },
      "TerminalErrorCode": {
        "enum": [
          "unauthorized",
          "unavailable",
          "conflict",
          "invalid_ticket",
          "invalid_input",
          "slow_client",
          "cleanup_uncertain"
        ],
        "type": "string"
      },
      "TerminalServerMessage": {
        "oneOf": [
          {
            "properties": {
              "type": {
                "enum": ["ready"],
                "type": "string"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          {
            "properties": {
              "code": {
                "$ref": "#/components/schemas/TerminalErrorCode"
              },
              "type": {
                "enum": ["detached"],
                "type": "string"
              }
            },
            "required": ["code", "type"],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": ["exit"],
                "type": "string"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          {
            "properties": {
              "code": {
                "$ref": "#/components/schemas/TerminalErrorCode"
              },
              "type": {
                "enum": ["error"],
                "type": "string"
              }
            },
            "required": ["code", "type"],
            "type": "object"
          }
        ]
      },
      "UserRole": {
        "enum": ["member", "admin"],
        "type": "string"
      },
      "UserStatus": {
        "enum": ["pending", "active", "suspended"],
        "type": "string"
      },
      "UsersResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminUser"
            },
            "type": "array"
          },
          "nextCursor": {
            "format": "uuid",
            "type": ["string", "null"]
          }
        },
        "required": ["items"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "in": "cookie",
        "name": "factory_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Local private identity API. Generated without runtime configuration.",
    "title": "Factory API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/users": {
      "get": {
        "operationId": "listUsers",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UserStatus"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersResponse"
                }
              }
            },
            "description": "Users in stable UUID order"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid input"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Session required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Access denied"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "User not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Conflict or protected administrator"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Rate limit"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Dependency unavailable"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/admin/users/{id}/access": {
      "patch": {
        "operationId": "changeAccess",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Session-bound CSRF value; exact frontend Origin also required.",
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUser"
                }
              }
            },
            "description": "Updated member access"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid input"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Session required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Access denied"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "User not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Conflict or protected administrator"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Rate limit"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Dependency unavailable"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/agent-connections/codex": {
      "get": {
        "operationId": "getCodexConnection",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentConnectionResponse"
                }
              }
            },
            "description": "Current account or unavailable state; pending codes belong only to their initiating session"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Active session required"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Operation owned by another session or environment changed"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Rate limit"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Identity unavailable"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/agent-connections/codex/login": {
      "post": {
        "operationId": "beginCodexLogin",
        "parameters": [
          {
            "description": "Session CSRF token; exact frontend Origin required; empty request body",
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentConnectionResponse"
                }
              }
            },
            "description": "Device authorization started; may already be connected"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Body must be empty"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Active session required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Origin or CSRF rejected"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Already pending, expired or environment changed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unsupported authentication method"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Rate limit"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid provider response or login failure"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Provider unavailable or cleanup uncertain"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/agent-connections/codex/login/cancel": {
      "post": {
        "operationId": "cancelCodexLogin",
        "parameters": [
          {
            "description": "Session CSRF token; exact frontend Origin required",
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelAgentLoginBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentConnectionResponse"
                }
              }
            },
            "description": "Operation cancellation confirmed"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid body"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Active session required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Origin or CSRF rejected"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Operation differs or environment changed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unsupported authentication method"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Rate limit"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid provider response or login failure"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Provider unavailable or cleanup uncertain"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/agent-connections/codex/logout": {
      "post": {
        "operationId": "logoutCodex",
        "parameters": [
          {
            "description": "Session CSRF token; exact frontend Origin required; empty request body",
