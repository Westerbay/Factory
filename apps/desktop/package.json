{
  "name": "@workspace/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview --skipBuild",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.renderer.json",
    "predev": "pnpm --filter @workspace/desktop^... build && install-electron",
    "prestart": "install-electron"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@workspace/core": "workspace:*",
    "@workspace/contracts": "workspace:*",
    "@workspace/application": "workspace:*",
    "@workspace/adapters": "workspace:*",
    "@workspace/database": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@workspace/config": "workspace:*",
    "@types/node": "24.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "vite": "8.3.5",
    "typescript": "5.9.3"
  }
}
